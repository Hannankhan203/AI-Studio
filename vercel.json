{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/upload/:subpath*",
      "destination": "/api/upload?__subpath=:subpath*"
    },
    {
      "source": "/api/conversations/:subpath*",
      "destination": "/api/conversations?__subpath=:subpath*"
    },
    {
      "source": "/api/messages/:subpath*",
      "destination": "/api/messages?__subpath=:subpath*"
    },
    {
      "source": "/api/users/:subpath*",
      "destination": "/api/users?__subpath=:subpath*"
    },
    {
      "source": "/api/user-settings/:subpath*",
      "destination": "/api/user-settings?__subpath=:subpath*"
    },
    {
      "source": "/api/db/:subpath*",
      "destination": "/api/db?__subpath=:subpath*"
    },
    {
      "source": "/api/auth/:subpath*",
      "destination": "/api/auth?__subpath=:subpath*"
    }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, PATCH, OPTIONS, DELETE" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, Accept, X-Title" }
      ]
    }
  ]
}
